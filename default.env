# Local environment for the engagement pipeline.
# Copy this to .env and set the absolute paths for your machine:
#
#   cp default.env .env
#
AIRFLOW_HOME=<ABSOLUTE-PATH-TO-THIS-DIRECTORY>/3-airflow
PYTHONPATH=<ABSOLUTE-PATH-TO-THIS-DIRECTORY>/3-airflow

# Keep Airflow's example DAGs out of the UI and out of the import-error list.
AIRFLOW__CORE__LOAD_EXAMPLES=False

# CRM connection used by the sync task.
CRM_BASE_URL=http://127.0.0.1:8020
CRM_API_TOKEN=crm-prod-token-9f3a2b
